{
  "private": true,
  "scripts": {
    "predev": "node bin/ensure-skulpt.cjs",
    "dev": "vite build",
    "prewatch": "node bin/ensure-skulpt.cjs",
    "watch": "vite build --watch",
    "prebuild": "node bin/ensure-skulpt.cjs",
    "build": "vite build",
    "testjs": "node_modules/.bin/jest",
    "test": "node_modules/.bin/jest && vendor/bin/phpunit",
    "pretest:e2e": "node bin/ensure-skulpt.cjs",
    "test:e2e": "vite build && playwright test",
    "preprod": "npm run skulpt",
    "prod": "vite build",
    "preproduction": "npm run skulpt",
    "production": "vite build",
    "skulpt": "npm --prefix node_modules/skulpt install --legacy-peer-deps && npm --prefix node_modules/skulpt run build",
    "refreshskulpt": "npm uninstall skulpt && npm install pingskills/skulpt#pyangelo --save-dev"
  },
  "jest": {
    "testEnvironment": "jest-environment-jsdom",
    "moduleNameMapper": {
      "\\.(css|scss|sass)$": "<rootDir>/resources/assets/js/__mocks__/styleMock.js",
      "^ace$": "<rootDir>/resources/assets/js/__mocks__/aceMock.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ]
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.18.6",
    "@playwright/test": "^1.64.1",
    "bootstrap-sass": "^3.4.1",
    "canvas-confetti": "^1.4.0",
    "eslint": "^8.19.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-vue": "^9.27.0",
    "font-awesome": "^4.7.0",
    "howler": "^2.2.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "jquery": "^3.5.1",
    "sass": "^1.39.2",
    "skulpt": "github:pingskills/skulpt#pyangelo",
    "split-grid": "^1.0.11",
    "tinymce": "^8.11.0",
    "toastify-js": "^1.11.2",
    "vite": "^8.3.8"
  }
}
